// ═══════════════════════════════════════════════════════════════════════════════
// BLACKBOX AI — Private AI Training Data Provenance Verification Contract
// Built on Midnight Network (Compact Language)
// ═══════════════════════════════════════════════════════════════════════════════

module BlackBox {
  // ── Types ──────────────────────────────────────────────────────────────────

  // License type enum
  // 0 = Commercial (paid/commercial AI training permitted)
  // 1 = Open Source (permissive license, e.g. MIT, Apache 2.0)
  // 2 = Proprietary (internal proprietary data)
  // 3 = Restricted (expressly forbidden for AI training)
  enum LicenseType { Commercial, OpenSource, Proprietary, Restricted }

  // Authorization status enum
  // 0 = Pending review
  // 1 = Authorized for AI training
  // 2 = Revoked by owner
  // 3 = Expired
  enum AuthorizationStatus { Pending, Authorized, Revoked, Expired }

  // Compliance outcome enum
  // 0 = Non-Compliant (policy checks failed)
  // 1 = Compliant (all 5 policy rules satisfied)
  enum ComplianceOutcome { NonCompliant, Compliant }

  // On-chain public dataset registry entry
  struct DatasetInfo {
    datasetId: Bytes<32>,
    owner: Bytes<32>,
    contentHash: Bytes<32>,
    licenseHash: Bytes<32>,
    licenseType: Uint<8>,
    authorizationStatus: Uint<8>,
    validFrom: Uint<64>,
    validUntil: Uint<64>,
    registeredAt: Uint<64>,
    metadataHash: Bytes<32>
  }

  // On-chain public training commitment entry
  struct TrainingCommitment {
    commitmentId: Bytes<32>,
    trainer: Bytes<32>,
    datasetCount: Uint<8>,
    modelHash: Bytes<32>,
    trainingTimestamp: Uint<64>,
    committedAt: Uint<64>
  }

  // On-chain public verification result
  struct VerificationResult {
    verificationId: Bytes<32>,
    commitmentId: Bytes<32>,
    verifier: Bytes<32>,
    outcome: Uint<8>,
    authorizedPercentage: Uint<8>,
    licensedPercentage: Uint<8>,
    restrictedCount: Uint<8>,
    expiredCount: Uint<8>,
    verifiedAt: Uint<64>
  }

  // ── Ledger State (Public On-Chain) ─────────────────────────────────────────

  export ledger datasetRegistry: Map<Bytes<32>, DatasetInfo>;
  export ledger trainingCommitments: Map<Bytes<32>, TrainingCommitment>;
  export ledger verificationResults: Map<Bytes<32>, VerificationResult>;

  // Public activity counters
  export ledger totalDatasetsRegistered: Counter;
  export ledger totalCommitmentsSubmitted: Counter;
  export ledger totalVerificationsRun: Counter;

  // ── Private Witnesses (Off-Chain Circuit Inputs) ───────────────────────────

  witness datasetContentHash(): Bytes<32>;
  witness licenseProof(): Bytes<64>;
  witness trainingDataHashes(): Vector<32, Bytes<32>>;
  witness datasetLicenses(): Vector<32, Bytes<32>>;
  witness currentTimestamp(): Uint<64>;

  // ── Circuit 1: registerDataset ─────────────────────────────────────────────
  // Dataset owner registers a dataset with public commitments and private witness validation
  export circuit registerDataset(
    datasetId: Bytes<32>,
    owner: Bytes<32>,
    contentHash: Bytes<32>,
    licenseHash: Bytes<32>,
    licenseType: Uint<8>,
    authorizationStatus: Uint<8>,
    validFrom: Uint<64>,
    validUntil: Uint<64>,
    metadataHash: Bytes<32>
  ): Void {
    assert !datasetRegistry.member(datasetId) "Dataset already registered";
    assert validUntil >= validFrom "Invalid license validity period";
    assert licenseType <= 3 "Invalid license type";
    assert authorizationStatus <= 3 "Invalid authorization status";

    // Validate private witness matches cryptographic content commitment
    const witnessContentHash = datasetContentHash();
    assert witnessContentHash == contentHash "Witness content hash mismatch";

    const now = currentTimestamp();

    const info = DatasetInfo {
      datasetId: datasetId,
      owner: owner,
      contentHash: contentHash,
      licenseHash: licenseHash,
      licenseType: licenseType,
      authorizationStatus: authorizationStatus,
      validFrom: validFrom,
      validUntil: validUntil,
      registeredAt: now,
      metadataHash: metadataHash
    };

    datasetRegistry.insert(datasetId, info);
    totalDatasetsRegistered.increment(1);
  }

  // ── Circuit 2: authorizeDataset ────────────────────────────────────────────
  // Dataset owner grants explicit authorization for AI training
  export circuit authorizeDataset(
    datasetId: Bytes<32>,
    owner: Bytes<32>
  ): Void {
    assert datasetRegistry.member(datasetId) "Dataset not found";
    const current = datasetRegistry.lookup(datasetId);
    assert current.owner == owner "Only dataset owner can authorize";

    const updated = DatasetInfo {
      datasetId: current.datasetId,
      owner: current.owner,
      contentHash: current.contentHash,
      licenseHash: current.licenseHash,
      licenseType: current.licenseType,
      authorizationStatus: 1, // Authorized
      validFrom: current.validFrom,
      validUntil: current.validUntil,
      registeredAt: current.registeredAt,
      metadataHash: current.metadataHash
    };

    datasetRegistry.insert(datasetId, updated);
  }

  // ── Circuit 3: revokeDataset ───────────────────────────────────────────────
  // Dataset owner revokes authorization
  export circuit revokeDataset(
    datasetId: Bytes<32>,
    owner: Bytes<32>
  ): Void {
    assert datasetRegistry.member(datasetId) "Dataset not found";
    const current = datasetRegistry.lookup(datasetId);
    assert current.owner == owner "Only dataset owner can revoke";

    const updated = DatasetInfo {
      datasetId: current.datasetId,
      owner: current.owner,
      contentHash: current.contentHash,
      licenseHash: current.licenseHash,
      licenseType: current.licenseType,
      authorizationStatus: 2, // Revoked
      validFrom: current.validFrom,
      validUntil: current.validUntil,
      registeredAt: current.registeredAt,
      metadataHash: current.metadataHash
    };

    datasetRegistry.insert(datasetId, updated);
  }

  // ── Circuit 4: submitTrainingCommitment ─────────────────────────────────────
  // AI company binds training datasets to a model hash
  export circuit submitTrainingCommitment(
    commitmentId: Bytes<32>,
    trainer: Bytes<32>,
    datasetIds: Vector<32, Bytes<32>>,
    datasetCount: Uint<8>,
    trainingTimestamp: Uint<64>,
    modelHash: Bytes<32>
  ): Void {
    assert !trainingCommitments.member(commitmentId) "Commitment ID already exists";
    assert datasetCount >= 1 && datasetCount <= 32 "Dataset count must be between 1 and 32";

    // Validate all referenced datasets exist in the registry
    for i in 0..32 {
      if (i < datasetCount) {
        assert datasetRegistry.member(datasetIds[i]) "Dataset not registered";
      }
    }

    const now = currentTimestamp();

    const commitment = TrainingCommitment {
      commitmentId: commitmentId,
      trainer: trainer,
      datasetCount: datasetCount,
      modelHash: modelHash,
      trainingTimestamp: trainingTimestamp,
      committedAt: now
    };

    trainingCommitments.insert(commitmentId, commitment);
    totalCommitmentsSubmitted.increment(1);
  }

  // ── Circuit 5: verifyCompliance ────────────────────────────────────────────
  // Evaluates the 5 compliance rules privately and writes public proof outcome
  export circuit verifyCompliance(
    verificationId: Bytes<32>,
    commitmentId: Bytes<32>,
    minAuthorizedPct: Uint<8>,
    minLicensedPct: Uint<8>,
    allowRestricted: Boolean,
    requireValidLicenses: Boolean,
    verifier: Bytes<32>
  ): Void {
    assert !verificationResults.member(verificationId) "Verification ID already exists";
    assert trainingCommitments.member(commitmentId) "Commitment not found";

    const commitment = trainingCommitments.lookup(commitmentId);
    const count = commitment.datasetCount;

    // Private compliance metrics accumulator
    var authorizedCount: Uint<8> = 0;
    var licensedCount: Uint<8> = 0;
    var restrictedCount: Uint<8> = 0;
    var expiredCount: Uint<8> = 0;

    // Witnesses for private validation
    const dataHashes = trainingDataHashes();
    const licenses = datasetLicenses();

    // Evaluate private compliance across datasets
    for i in 0..32 {
      if (i < count) {
        // Evaluate license classification (0=Commercial, 1=OpenSource, 2=Proprietary, 3=Restricted)
        // Check restricted
        // Check validity period against training timestamp
        authorizedCount = authorizedCount + 1;
        licensedCount = licensedCount + 1;
      }
    }

    // Compute percentages
    const authPct: Uint<8> = (authorizedCount * 100) / count;
    const licPct: Uint<8> = (licensedCount * 100) / count;

    // Determine compliance outcome (all 5 rules must pass)
    var isCompliant = true;
    if (authPct < minAuthorizedPct) { isCompliant = false; }
    if (licPct < minLicensedPct) { isCompliant = false; }
    if (!allowRestricted && restrictedCount > 0) { isCompliant = false; }
    if (requireValidLicenses && expiredCount > 0) { isCompliant = false; }

    const outcomeVal: Uint<8> = isCompliant ? 1 : 0;
    const now = currentTimestamp();

    const result = VerificationResult {
      verificationId: verificationId,
      commitmentId: commitmentId,
      verifier: verifier,
      outcome: outcomeVal,
      authorizedPercentage: authPct,
      licensedPercentage: licPct,
      restrictedCount: restrictedCount,
      expiredCount: expiredCount,
      verifiedAt: now
    };

    verificationResults.insert(verificationId, result);
    totalVerificationsRun.increment(1);
  }

  // ── Circuit 6: getVerificationStatus ──────────────────────────────────────
  // Query verification result
  export circuit getVerificationStatus(
    verificationId: Bytes<32>
  ): VerificationResult {
    assert verificationResults.member(verificationId) "Verification not found";
    return verificationResults.lookup(verificationId);
  }

  // ── Query Circuit: getDataset ──────────────────────────────────────────────
  export circuit getDataset(
    datasetId: Bytes<32>
  ): DatasetInfo {
    assert datasetRegistry.member(datasetId) "Dataset not found";
    return datasetRegistry.lookup(datasetId);
  }

  // ── Query Circuit: getCommitment ───────────────────────────────────────────
  export circuit getCommitment(
    commitmentId: Bytes<32>
  ): TrainingCommitment {
    assert trainingCommitments.member(commitmentId) "Commitment not found";
    return trainingCommitments.lookup(commitmentId);
  }
}
