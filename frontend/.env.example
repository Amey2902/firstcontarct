# BlackBox AI — frontend environment
#
# Copy to .env.local and adjust. `npm run dev` reads VITE_* vars from .env.local.
#
# Network the DApp connects to via the DApp Connector (Lace).
# Canonical setting for the bootcamp; VITE_NETWORK_ID is accepted as a legacy alias.
VITE_NETWORK=preview

# Preview testnet indexer (GraphQL + WebSocket).
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# The deployed BlackBox AI contract on the active network.
# Update after deployment with: npm run deploy
VITE_CONTRACT_ADDRESS=

# Fallback proof server. The wallet's own configuration is preferred when it
# reports a proverServerUri; this is used otherwise (e.g. a local proof server
# for the bundled devnet).
VITE_PROOF_SERVER_URL=http://localhost:6300

# Private state password (min 16 characters for production)
VITE_PRIVATE_STATE_PASSWORD=Local-Devnet-Development-Placeholder-1